# Copy these two lines from Supabase → Connect → Framework (Next.js) → .env.local.
# On Vercel, add them under Project → Settings → Environment Variables.
# (Older Supabase projects call the key NEXT_PUBLIC_SUPABASE_ANON_KEY; the app accepts either name.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
